{
  // RAWRS in GitHub Codespaces: the same toolchain the Tests workflow uses
  // (.github/workflows/tests.yml), on a machine with room for the backend.
  "name": "RAWRS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // The backend needs >= 8 GB just to run; 16 GB leaves room for the test suite.
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8001, 3000],
  "portsAttributes": {
    "8001": { "label": "RAWRS API" },
    "3000": { "label": "RAWRS frontend" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"]
    }
  }
}
